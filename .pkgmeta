package-as: GathererReforged
enable-nolib-creation: yes
enable-toc-creation: yes

externals:
    libs/LibStub: https://github.com/WoWUIDev/Ace3.git/LibStub
    libs/CallbackHandler-1.0: https://github.com/WoWUIDev/Ace3.git/CallbackHandler-1.0
    libs/AceAddon-3.0: https://github.com/WoWUIDev/Ace3.git/AceAddon-3.0
    libs/AceEvent-3.0: https://github.com/WoWUIDev/Ace3.git/AceEvent-3.0
    libs/AceTimer-3.0: https://github.com/WoWUIDev/Ace3.git/AceTimer-3.0
    libs/AceBucket-3.0: https://github.com/WoWUIDev/Ace3.git/AceBucket-3.0
    libs/AceHook-3.0: https://github.com/WoWUIDev/Ace3.git/AceHook-3.0
    libs/AceDB-3.0: https://github.com/WoWUIDev/Ace3.git/AceDB-3.0
    libs/AceDBOptions-3.0: https://github.com/WoWUIDev/Ace3.git/AceDBOptions-3.0
    libs/AceLocale-3.0: https://github.com/WoWUIDev/Ace3.git/AceLocale-3.0
    libs/AceConsole-3.0: https://github.com/WoWUIDev/Ace3.git/AceConsole-3.0
    libs/AceGUI-3.0: https://github.com/WoWUIDev/Ace3.git/AceGUI-3.0
    libs/AceConfig-3.0: https://github.com/WoWUIDev/Ace3.git/AceConfig-3.0
    libs/AceComm-3.0: https://github.com/WoWUIDev/Ace3.git/AceComm-3.0
    libs/AceTab-3.0: https://github.com/WoWUIDev/Ace3.git/AceTab-3.0
    libs/AceSerializer-3.0: https://github.com/WoWUIDev/Ace3.git/AceSerializer-3.0
    libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1.git
    libs/LibDBIcon-1.0: https://repos.wowace.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0
    libs/LibSharedMedia-3.0: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0

manual-changelog: CHANGELOG.md

ignore:
    - .github
    - .gitignore
    - .gitattributes
    - .luacheckrc
    - .pkgmeta
    - CHANGELOG.md
    - README.md
    - LICENSE
