	<Frame name="Gatherer_Hud" parent="UIParent" hidden="true" enableMouse="false">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="Gatherer_Hud_Base" file="Interface\AddOns\GathererReborn\GUI\HudShape" alphaMode="DISABLE">
					<Color r="0" g="0" b="0" a="1"/>
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="Gatherer_Hud_Center" file="Interface\AddOns\GathererReborn\GUI\HudShape" alphaMode="DISABLE">
					<Color r="0" g="0" b="0" a="1"/>
					<Anchors>
						<Anchor point="CENTER">
							<Offset>
								<AbsDimension x="0" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Frames>
			<Frame name="Gatherer_Hud_Heat" setAllPoints="true"/>
		</Frames>
		<Scripts>
			<OnLoad>
				Gatherer_HUD.Load(self);
				Gatherer_HUD.Register();
				Gatherer_HUD.UpdateStruture();
			</OnLoad>
			<OnEvent>
				Gatherer_HUD.ProcessGameEvent(event)
			</OnEvent>
		</Scripts>
	</Frame>
	<Frame name="Gatherer_Hud_Sync" parent="UIParent" enableMouse="false">
		<Scripts>
			<OnUpdate>
				if (Gatherer_HUD and Gatherer_HUD.RunUpdate) then
					Gatherer_HUD.RunUpdate(elapsed)
				end
			</OnUpdate>
		</Scripts>
	</Frame>
</Ui>
