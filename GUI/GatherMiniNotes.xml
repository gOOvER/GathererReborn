	<Script file = "GatherMiniNotes.lua"/>
	
	<Frame name="GatherMiniNoteUpdateFrame" hidden="true" parent="Minimap">
		<Scripts>
			<OnLoad>
				Gatherer.MiniNotes.OnLoad(self)
			</OnLoad>
			<OnUpdate>
				Gatherer.MiniNotes.UpdateMinimapNotes(elapsed)
			</OnUpdate>
			<OnShow>
				Gatherer.MiniNotes.UpdateMinimapNotes(0, true)
			</OnShow>
		</Scripts>
	</Frame>
	
	<!-- Minimap Note Template -->
	<Button name="GatherNoteTemplate" hidden="true" parent="Minimap" virtual="true">
		<Size x="12" y="12"/>
		<Scripts>
			<OnLoad>
				Gatherer.MiniNotes.OnNoteCreation(self)
			</OnLoad>
			<OnEnter>
				Gatherer.MiniNotes.MiniNoteOnEnter(self)
			</OnEnter>
			<OnLeave>
				Gatherer.Tooltip.HideTooltips()
			</OnLeave>
			<OnMouseUp>
				Gatherer.MiniNotes.MiniNoteOnClick(self, button)
			</OnMouseUp>
		</Scripts>
		<NormalTexture file="Interface\Icons\INV_Misc_QuestionMark"/>
	</Button>
	<Button name="GatherArchNoteTemplate" inherits="GatherNoteTemplate" hidden="true"  parent="Minimap" virtual="true">
		<NormalTexture file="Interface/MINIMAP/TRACKING/OBJECTICONS">
			<!--                5/256             29/256           3/64              27/64 -->
			<TexCoords left="0.01953125" right="0.11328125" top="0.046875" bottom="0.421875" />
		</NormalTexture>
	</Button>
</Ui>


